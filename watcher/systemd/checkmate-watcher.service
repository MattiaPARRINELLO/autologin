[Unit]
Description=CheckMate watcher (surveillance emargement CESAR)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/checkmate-watcher --config %h/.config/checkmate-watcher/config.toml run
Restart=always
RestartSec=10
# Decommenter si les notifications ne s'affichent pas
# Environment=DISPLAY=:0
# Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=graphical-session.target
